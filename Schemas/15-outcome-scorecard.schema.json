  "title": "Outcome Scorecard",
  "description": "Recurring, dated snapshot of performance across seven dimensions. Chapter 32 \u00a715.",
  "x-oasis-artifact-id": 15,
  "x-oasis-tools-reference": "https://raw.githubusercontent.com/knowledgetrailsai/OASIS/main/Tools/04-readiness-and-operations-templates.md#15-outcome-scorecard",
  "type": "array",
  "items": {
