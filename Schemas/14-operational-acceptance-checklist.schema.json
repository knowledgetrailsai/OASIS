  "title": "Operational Acceptance Checklist",
  "description": "Confirms a system is actually working once live users have touched it. Ten fixed items. Chapter 32 \u00a714.",
  "x-oasis-artifact-id": 14,
  "x-oasis-tools-reference": "https://raw.githubusercontent.com/knowledgetrailsai/OASIS/main/Tools/04-readiness-and-operations-templates.md#14-operational-acceptance-checklist",
  "type": "array",
  "items": {
